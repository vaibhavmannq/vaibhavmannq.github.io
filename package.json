{
  "name": "vaibhavmannq.github.io",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "size": "size-limit",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.2.0",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "lil-gui": "0.21.0",
    "size-limit": "14.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
